    		<script>
		//#user_reg >
		$(document).ready(function(){
			//alert('inputname changed!');
			const arr = new Map([]);
		$('#user_reg input[required]').change(function() {
				//alert('inputname changed1!');
				// ajax запрос на проверку
				var divp = $(this).closest('.form-group');
				//alert(divp.attr('id'));
				var atrname = $(this).attr('name');
				//alert(atrname);
				var datainp = $(this).serialize();
				$.ajax({
					type: "POST",
					url: "/ajax/formreg.php",
					dataType: "json",
					data: datainp,
					success: function(data){
						//alert(data.res);
						if(data.res == 1){
							//alert(data.res);
							$(divp).removeClass("has-error"); 
							$(divp).addClass("has-success"); // has-feedback
							$(divp).find("div >span").removeClass('glyphicon-remove');
							$(divp).find("div >span").addClass('glyphicon-ok');
							$(divp).find("div > p").empty();
							//$(divp).find("p.text-danger").html(data.text);
							arr.set('a'+atrname,'1');
							setControls();
							//$("#controls").prop('disabled', false);
							
						}else{
							$(divp).removeClass("has-success");
							$(divp).addClass("has-error"); // has-feedback
							$(divp).find("div >span").removeClass('glyphicon-ok');
							$(divp).find("div >span").addClass('glyphicon-remove');
							$(divp).find("p.text-danger").html(data.text);
							$("#controls_reg").prop('disabled', true);
							arr.delete('a'+atrname);
							setControls();
							//alert(data.text);
							
						}
					}
				});
				/**/		
			
		});
		//---------------------------------------------------------------
		// Состояние кнопки Отправить
		function setControls(){
			//alert( 'Всем привет!' );
			//alert('Всем привет! = '+arr.size);
			if(arr.size>4 && $('#customCheck').is(':checked')){
			//alert(arr.size);
				$('#controls_reg').prop('disabled', false);
			} else {
				$('#controls_reg').prop('disabled', true);
			}
		}
		//---------------------------------------------------------------
		// Состояние кнопки Отправить
		function setError(nname,text){
			//alert( 'Всем привет!'+nname );
			var divp = $('input[name='+nname+']').closest('.form-group');
			$(divp).removeClass("has-success");
			$(divp).addClass("has-error"); // has-feedback
			$(divp).find("div >span").removeClass('glyphicon-ok');
			$(divp).find("div >span").addClass('glyphicon-remove');
			$(divp).find("p.text-danger").html(text);
			arr.delete('a'+nname);
			setControls();
			
		}
		//---------------------------------------------------------------
		$('#customCheck').change(function(){
			setControls();
		});
		// Выполняем форму
		$('#controls_reg').click(function() {
			//alert('Сохраняем данные');
			//если форма валидна, то
			if (arr.size>4 && $('#customCheck').is(':checked')) {
				
				var formdata = $('#user_reg').serialize();
				// ajax обработка формы
				$.ajax({
					type: "POST",
					url: "/ajax/formsave.php",
					dataType: "json",
					data: formdata,
					success: function(data){
						//alert(data.res);
						if(data.res == 1){
							//alert(data.res);
							//сркыть модальное окно
							$('#formreg').modal('hide');
							//отобразить сообщение об успехе
							$('#success-alert').modal('show');
							
							
						}else{
							
							if(data.name){setError('name',data.name);}
							if(data.email){setError('email',data.email);}
							if(data.reg_login){setError('reg_login',data.reg_login);}
							if(data.reg_pas){setError('reg_pas',data.reg_pas);}
							if(data.kod){setError('kod',data.kod);}
							
							
						}
					}
				});
				
			}
		});		
	});//jQuery	
	</script>

		</body>
</html>
